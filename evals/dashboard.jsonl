{"id": "cols-combo-1", "user": "alice", "prompt": "hide the revenue column and move status after date", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "appointments", "path": ["columns", "revenue", "hidden"], "value": true}, {"op": "move", "node": "appointments", "prop": "columns", "key": "status", "to": {"after": "date"}}]}}
{"id": "cols-label-1", "user": "alice", "prompt": "Rename the vet column to Doctor", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "appointments", "path": ["columns", "vet", "label"], "value": "Doctor"}]}}
