{"id": "preset-1", "user": "alice", "prompt": "Add a no-shows card", "expect": {"kind": "patch", "ops": [{"op": "insert", "node": "kpis", "prop": "cards", "preset": "stat.noShows", "key": "u_eval", "to": "end"}]}}
