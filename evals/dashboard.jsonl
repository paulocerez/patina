{"id": "layout-7", "user": "alice", "prompt": "hide the visits card", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "kpis", "path": ["cards", "stat-visits", "hidden"], "value": true}]}}
{"id": "filter-1", "user": "alice", "prompt": "Default the filter to this week", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "filters", "path": ["dateRange"], "value": {"relative": "thisWeek"}}]}}
