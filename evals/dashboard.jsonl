{"id": "table-4", "user": "alice", "prompt": "oldest appointments first", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "appointments", "path": ["sort"], "value": {"key": "date", "dir": "asc"}}]}}
{"id": "table-5", "user": "alice", "prompt": "sort by revenue, highest first", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "appointments", "path": ["sort"], "value": {"key": "revenue", "dir": "desc"}}]}}
{"id": "chart-1", "user": "alice", "prompt": "Make the chart a bar chart", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "revenue-chart", "path": ["kind"], "value": "bar"}]}}
{"id": "chart-2", "user": "alice", "prompt": "group revenue by month", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "revenue-chart", "path": ["groupBy"], "value": "month"}]}}
