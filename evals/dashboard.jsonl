{"id": "layout-2", "user": "alice", "prompt": "I want the table at the top of the page", "expect": {"kind": "patch", "ops": [{"op": "move", "node": "page", "prop": "main", "key": "appointments", "to": "start"}]}}
{"id": "layout-3", "user": "alice", "prompt": "hide the revenue chart", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "page", "path": ["main", "revenue-chart", "hidden"], "value": true}]}}
{"id": "layout-4", "user": "alice", "prompt": "Get rid of the KPI cards", "expect": {"kind": "patch", "ops": [{"op": "set", "node": "page", "path": ["main", "kpis", "hidden"], "value": true}]}}
{"id": "layout-5", "user": "alice", "prompt": "move the filters to the bottom", "expect": {"kind": "patch", "ops": [{"op": "move", "node": "page", "prop": "main", "key": "filters", "to": "end"}]}}
