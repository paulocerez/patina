{"id": "data-chart-1", "user": "alice", "prompt": "Add a bar chart of revenue by vet", "expect": {"kind": "patch", "ops": [{"op": "insert", "node": "page", "prop": "main", "preset": "block.chart", "key": "u_eval", "to": "end", "props": {"kind": "bar", "query": {"source": "appointments", "groupBy": {"field": "vet"}, "metric": {"op": "sum", "field": "revenue"}}}}]}, "ignoreOrder": true, "note": "The prompt doesn't say where the chart goes, so any position is fine."}
{"id": "data-chart-2", "user": "alice", "prompt": "add a line chart with the number of appointments per week", "expect": {"kind": "patch", "ops": [{"op": "insert", "node": "page", "prop": "main", "preset": "block.chart", "key": "u_eval", "to": "end", "props": {"kind": "line", "query": {"source": "appointments", "groupBy": {"field": "date", "bucket": "week"}, "metric": {"op": "count"}}}}]}, "ignoreOrder": true, "note": "The prompt doesn't say where the chart goes, so any position is fine."}
{"id": "data-chart-3", "user": "alice", "prompt": "chart how many appointments each species has", "expect": {"kind": "patch", "ops": [{"op": "insert", "node": "page", "prop": "main", "preset": "block.chart", "key": "u_eval", "to": "end", "props": {"kind": "bar", "query": {"source": "appointments", "groupBy": {"field": "species"}, "metric": {"op": "count"}}}}]}, "ignoreOrder": true, "note": "The prompt doesn't say where the chart goes, so any position is fine."}
{"id": "data-stat-1", "user": "alice", "prompt": "add a card with the number of no-shows", "expect": {"kind": "patch", "ops": [{"op": "insert", "node": "kpis", "prop": "cards", "preset": "block.stat", "key": "u_eval", "to": "end", "props": {"query": {"source": "appointments", "metric": {"op": "count"}, "where": [{"field": "status", "value": "noShow"}]}}}], "alternatives": [[{"op": "insert", "node": "kpis", "prop": "cards", "preset": "stat.noShows", "key": "u_eval", "to": "end"}]]}, "note": "The existing No-shows preset card is an equally good answer.", "ignoreOrder": true}
{"id": "data-stat-2", "user": "alice", "prompt": "add a card showing the average revenue per appointment", "expect": {"kind": "patch", "ops": [{"op": "insert", "node": "kpis", "prop": "cards", "preset": "block.stat", "key": "u_eval", "to": "end", "props": {"query": {"source": "appointments", "metric": {"op": "avg", "field": "revenue"}}}}], "alternatives": [[{"op": "insert", "node": "kpis", "prop": "cards", "preset": "stat.avgRevenue", "key": "u_eval", "to": "end"}]]}, "ignoreOrder": true, "note": "The existing Average revenue preset card is an equally good answer."}
