{
  "name": "patina-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "demo": "pnpm --filter demo dev",
    "eval": "pnpm --filter evals eval",
    "docs:api": "pnpm --filter typedoc-tool docs:api",
    "pack:local": "bash scripts/pack-local.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^26.6.11",
    "fast-check": "^4.11.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
