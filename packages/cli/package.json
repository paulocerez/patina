{
  "name": "@patina-ui/cli",
  "version": "0.1.0",
  "description": "patina scan / check / init-action: detects the data your API exposes and your design system, drafts a data catalog and matching data blocks.",
  "keywords": [
    "patina-ui",
    "cli",
    "codegen",
    "openapi",
    "prisma",
    "zod",
    "design-system",
    "github-action"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulocerez/patina.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/paulocerez/patina/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/paulocerez/patina/issues"
  },
  "type": "module",
  "bin": {
    "patina": "./bin/patina.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean --external @patina-ui/core --external @anthropic-ai/sdk --external @patina-ui/server --external pg && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@patina-ui/core": "workspace:^",
    "@patina-ui/server": "workspace:^",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
