{
  "name": "@patina/cli",
  "version": "0.0.0",
  "description": "patina scan / check / init-action: detects the data your API exposes and your design system, and drafts a catalog and matching data blocks.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "patina": "./bin/patina.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean --external @patina/core --external @anthropic-ai/sdk && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@patina/core": "workspace:*",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15"
  }
}
