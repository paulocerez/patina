{
  "name": "@patina/react",
  "version": "0.0.0",
  "description": "React bindings and headless UX primitives for Patina.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@patina/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@patina/server": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^19.3.1"
  }
}
