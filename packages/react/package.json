{
  "name": "@patina-ui/react",
  "version": "0.6.0",
  "description": "React bindings for Patina UI: <Surface> renderer, hooks, and headless UX primitives for prompt-driven customization.",
  "keywords": [
    "patina-ui",
    "react",
    "ui",
    "customization",
    "personalization",
    "llm",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulocerez/patina.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/paulocerez/patina/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/paulocerez/patina/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/cjs/index.d.ts",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/cjs-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@patina-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@patina-ui/server": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^19.3.1"
  }
}
