{
  "name": "@patina-ui/core",
  "version": "0.4.1",
  "description": "Spec, capability manifest, patch engine and data catalog for prompt-driven UI customization. No framework or LLM dependencies.",
  "keywords": [
    "patina-ui",
    "ui",
    "customization",
    "personalization",
    "llm",
    "patch",
    "json-patch",
    "schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulocerez/patina.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/paulocerez/patina/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/paulocerez/patina/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/cjs/index.d.ts",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/cjs-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  }
}
