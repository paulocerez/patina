{
  "name": "@patina-ui/server",
  "version": "0.5.0",
  "description": "Patina UI server: fetch-style request handler, Anthropic model adapter, memory and Postgres storage, Express adapter, eval runner, follow-ups (Linear, Slack, GitHub, Jira, HubSpot) and analytics (PostHog, Sentry).",
  "keywords": [
    "patina-ui",
    "llm",
    "anthropic",
    "claude",
    "customization",
    "express",
    "postgres",
    "linear",
    "slack",
    "github",
    "jira",
    "hubspot",
    "posthog",
    "sentry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulocerez/patina.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/paulocerez/patina/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/paulocerez/patina/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./anthropic": "./src/anthropic.ts",
    "./express": "./src/express.ts",
    "./testing": "./src/testing.ts",
    "./eval": "./src/eval.ts",
    "./followups": "./src/followups.ts",
    "./integrations": "./src/integrations.ts",
    "./drizzle": "./src/drizzle.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/index.cjs"
        }
      },
      "./anthropic": {
        "import": {
          "types": "./dist/anthropic.d.ts",
          "default": "./dist/anthropic.js"
        },
        "require": {
          "types": "./dist/cjs/anthropic.d.ts",
          "default": "./dist/anthropic.cjs"
        }
      },
      "./express": {
        "import": {
          "types": "./dist/express.d.ts",
          "default": "./dist/express.js"
        },
        "require": {
          "types": "./dist/cjs/express.d.ts",
          "default": "./dist/express.cjs"
        }
      },
      "./testing": {
        "import": {
          "types": "./dist/testing.d.ts",
          "default": "./dist/testing.js"
        },
        "require": {
          "types": "./dist/cjs/testing.d.ts",
          "default": "./dist/testing.cjs"
        }
      },
      "./eval": {
        "import": {
          "types": "./dist/eval.d.ts",
          "default": "./dist/eval.js"
        },
        "require": {
          "types": "./dist/cjs/eval.d.ts",
          "default": "./dist/eval.cjs"
        }
      },
      "./followups": {
        "import": {
          "types": "./dist/followups.d.ts",
          "default": "./dist/followups.js"
        },
        "require": {
          "types": "./dist/cjs/followups.d.ts",
          "default": "./dist/followups.cjs"
        }
      },
      "./integrations": {
        "import": {
          "types": "./dist/integrations.d.ts",
          "default": "./dist/integrations.js"
        },
        "require": {
          "types": "./dist/cjs/integrations.d.ts",
          "default": "./dist/integrations.cjs"
        }
      },
      "./drizzle": {
        "import": {
          "types": "./dist/drizzle.d.ts",
          "default": "./dist/drizzle.js"
        },
        "require": {
          "types": "./dist/cjs/drizzle.d.ts",
          "default": "./dist/drizzle.cjs"
        }
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/cjs/index.d.ts",
    "typesVersions": {
      "*": {
        "anthropic": [
          "./dist/cjs/anthropic.d.ts"
        ],
        "express": [
          "./dist/cjs/express.d.ts"
        ],
        "testing": [
          "./dist/cjs/testing.d.ts"
        ],
        "eval": [
          "./dist/cjs/eval.d.ts"
        ],
        "followups": [
          "./dist/cjs/followups.d.ts"
        ],
        "integrations": [
          "./dist/cjs/integrations.d.ts"
        ],
        "drizzle": [
          "./dist/cjs/drizzle.d.ts"
        ]
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/cjs-types.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@patina-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.90.0",
    "drizzle-orm": ">=0.36.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.23.1"
  }
}
