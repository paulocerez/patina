{
  "name": "@patina-ui/server",
  "version": "0.2.0",
  "description": "Patina UI server: fetch-style request handler, Anthropic model adapter, memory and Postgres storage, Express adapter, eval runner.",
  "keywords": [
    "patina-ui",
    "llm",
    "anthropic",
    "claude",
    "customization",
    "express",
    "postgres"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulocerez/patina.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/paulocerez/patina/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/paulocerez/patina/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./anthropic": "./src/anthropic.ts",
    "./express": "./src/express.ts",
    "./testing": "./src/testing.ts",
    "./eval": "./src/eval.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./anthropic": {
        "types": "./dist/anthropic.d.ts",
        "import": "./dist/anthropic.js"
      },
      "./express": {
        "types": "./dist/express.d.ts",
        "import": "./dist/express.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./eval": {
        "types": "./dist/eval.d.ts",
        "import": "./dist/eval.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/anthropic.ts src/express.ts src/testing.ts src/eval.ts --format esm --clean --external @patina-ui/core --external @anthropic-ai/sdk && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@patina-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
