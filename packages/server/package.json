{
  "name": "@patina/server",
  "version": "0.0.0",
  "description": "Request handler, model adapters and storage adapters for Patina.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./anthropic": "./src/anthropic.ts",
    "./express": "./src/express.ts",
    "./testing": "./src/testing.ts",
    "./eval": "./src/eval.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./anthropic": {
        "types": "./dist/anthropic.d.ts",
        "import": "./dist/anthropic.js"
      },
      "./express": {
        "types": "./dist/express.d.ts",
        "import": "./dist/express.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./eval": {
        "types": "./dist/eval.d.ts",
        "import": "./dist/eval.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/anthropic.ts src/express.ts src/testing.ts src/eval.ts --format esm --clean --external @patina/core --external @anthropic-ai/sdk && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@patina/core": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@electric-sql/pglite": "^0.6.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
